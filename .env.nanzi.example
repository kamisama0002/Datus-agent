# Secret-free NanZi environment template. Use this file only as an inventory;
# set values in the local process or a secret manager and do not commit a
# completed copy. The callback must be loopback, for example
# http://127.0.0.1:8000.
NANZI_CALLBACK_URL=http://127.0.0.1:8000
NANZI_DATUS_INTERNAL_TOKEN=
